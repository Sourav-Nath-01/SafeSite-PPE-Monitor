# Allow-list: the image needs the service code, the dependency list and one
# checkpoint. Everything else (dataset, videos, other runs, exports, .git)
# stays out, which keeps the build context - uploaded on every CI build - small.
*
!requirements.txt
!Model-Deployment/
!Model-Training/Outputs/runs/detect/yolov8s_ppe_css_200_epochs/weights/best.pt

# Runtime state and tests from a local run must not be baked into the image.
Model-Deployment/tests/
Model-Deployment/snapshots/
Model-Deployment/*.db
Model-Deployment/*.db-*
Model-Deployment/settings.json
Model-Deployment/instance_counter.json
**/__pycache__/
**/*.pyc
